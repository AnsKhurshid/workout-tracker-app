  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"weight_unit\" TEXT NOT NULL DEFAULT 'kg' CHECK(\"weight_unit\" IN ('kg', 'lbs')), \"default_rest_seconds\" INTEGER NOT NULL DEFAULT 90 CHECK(\"default_rest_seconds\" BETWEEN 0 AND 3600), \"auto_start_rest_timer\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_start_rest_timer\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_updated_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "sync_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"user_id\" TEXT NOT NULL, \"entity_table\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"enqueued_at\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" TEXT NOT NULL, \"last_error\" TEXT NULL, \"state\" TEXT NOT NULL DEFAULT 'pending' CHECK(\"state\" IN ('pending', 'failed')), UNIQUE (\"entity_table\", \"record_id\"));"
        }
      ]
    },
    {
      "name": "sync_cursors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_cursors\" (\"user_id\" TEXT NOT NULL, \"entity_table\" TEXT NOT NULL, \"cursor\" TEXT NULL, \"last_synced_at\" TEXT NULL, PRIMARY KEY (\"user_id\", \"entity_table\"));"
        }
      ]
    }
