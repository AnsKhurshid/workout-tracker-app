# Gym Tracker build-time configuration.
#
# Copy this file to `.env` (git-ignored) and fill in the values from your
# Supabase project: Project Settings -> API Keys.
#
# Run the app with:
#   flutter run --dart-define-from-file=.env
#
# SUPABASE_PUBLISHABLE_KEY takes the project's publishable key
# (sb_publishable_...). The legacy "anon" public key also works.
# Data is protected by Row Level Security.
# NEVER put the secret / service_role key in this file.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
